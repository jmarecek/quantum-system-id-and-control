@article{Guller1996,
author = {G\"{u}ler, Osman},
title = {Barrier Functions in Interior Point Methods},
journal = {Mathematics of Operations Research},
volume = {21},
number = {4},
pages = {860-885},
year = {1996},
doi = {10.1287/moor.21.4.860},

URL = { 
    
